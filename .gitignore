# Каталоги сборки — ТОЛЬКО в корне репозитория.
# Без ведущего слэша шаблон "build/" матчит каталог build на ЛЮБОЙ глубине и
# молча исключал Tool/skills/build/SKILL.md: на GitHub было 8 скиллов вместо 9,
# то есть фаза /build отсутствовала в репозитории, не появляясь в git status.
/dist/
/build/

*.log
.env
.env.local

# Runtime-состояние: переписывается при каждом запуске и при каждом прогоне
# тестов. Держать его под версионным контролем — значит получать шум в каждом
# диффе и ложные конфликты. Классификатор их и так игнорирует (exclusions в
# .ai-loop/policy/protected_paths.yaml).
.ai_workspace_state.json
Core/failures.jsonl

# .size_ratchets.json НАМЕРЕННО остаётся под версионным контролем: это не
# runtime-шум, а база принуждения инварианта shrink-only. При отсутствии файла
# SizeRatchets._load_limits() возвращает {} — на свежем клоне храповики молча
# отключаются. Шум в диффах здесь предпочтительнее тихо снятого ограничения.

# Документы, содержащие Telegram ID оператора. Репозиторий ПУБЛИЧНЫЙ —
# эти файлы остаются только локально. Обезличенные версии (при необходимости)
# можно завести отдельно.
docs/(Telegram Connector)__ в архитектурный каркас __Why_Ai v1.1.0-Gold__.md
docs/https___github.com_VlaD-KH_Why_Ai_ Извлеки предст.txt
