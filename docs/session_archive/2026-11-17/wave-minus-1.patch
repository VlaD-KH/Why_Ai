+
+  # Third, independent check: the evidentiary test suite and the start gate.
+  # A separate job on purpose: the classify job ends at the verdict step on every
+  # zone-R pull request (require_human -> exit 1), so a step appended there would
+  # never run on exactly the changes that need it most.
+  tests:
+    name: unit tests and start gate
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.11"
+      - name: Evidentiary unit tests
+        run: python -m unittest discover -s tests -p "test_*.py"
+      - name: Start gate (run_mvp.py --self-test must exit 0)
+        run: python run_mvp.py --self-test
